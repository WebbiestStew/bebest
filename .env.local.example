# Airtable
NEXT_PUBLIC_AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_API_TOKEN=your_airtable_personal_access_token_here

# Supabase (not currently used by the app — kept for future reference)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_JWT_SECRET=your_jwt_secret_here

# App
NEXTAUTH_SECRET=generate_a_random_secret_string_here
NEXTAUTH_URL=http://localhost:3000

# Admin auth (generate with bcryptjs: bcrypt.hash(password, 10))
# NOTE: escape every $ as \$ - Next.js expands unescaped $VAR in .env files
ADMIN_PASSWORD_HASH=bcrypt_hash_here
